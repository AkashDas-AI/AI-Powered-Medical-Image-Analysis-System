# Environment Configuration Template
# Copy this file to .env and populate with local values if required.
# Note: Never commit .env containing actual secret keys to source control.

# Application Environment (development, testing, production)
APP_ENV=development

# Optional Seed for Reproducibility
RANDOM_SEED=42

# Optional Custom Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Custom Directory Overrides
# RSNA_DICOM_DIR=data/raw/rsna/dicom
# MODEL_CHECKPOINT_DIR=models
